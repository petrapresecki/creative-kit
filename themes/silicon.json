{
  "id": "silicon",
  "name": "Silicon",
  "description": "A low-resolution screen on white: a tall stepped bitmap face for titles, a pixel sans for text and captions, near-black ink, one green 'live' dot, outlined pills and hairlines.",
  "inspiredBy": ["lib-leere", "lib-leere-line", "lib-leere-scatter", "lib-leere-echo"],
  "colors": { "paper": "#ffffff", "ink": "#1e1d1d", "accent": "#2ecc71", "mist": "#eeeeee", "muted": "#6b6b6b" },
  "palette": [
    { "name": "Phosphor", "value": "#c9f7d9" },
    { "name": "Link blue", "value": "#0000ee" }
  ],
  "fonts": {
    "sans": { "family": "Pixelify Sans", "fallback": "'Departure Mono', ui-monospace, Menlo, monospace", "google": "Pixelify+Sans:wght@400;500;700" },
    "display": { "family": "Handjet", "fallback": "'Pixelify Sans', ui-monospace, monospace", "google": "Handjet:wght@500;700" }
  },
  "type": [
    { "name": "display", "size": "clamp(72px, 13vw, 240px)", "leading": "0.82", "tracking": "0", "weight": 700, "font": "display" },
    { "name": "headline", "size": "clamp(48px, 7vw, 128px)", "leading": "0.85", "tracking": "0", "weight": 700, "font": "display" },
    { "name": "title", "size": "clamp(24px, 2.4vw, 36px)", "leading": "1.05", "tracking": "-0.01em", "weight": 500 },
    { "name": "lead", "size": "clamp(18px, 1.5vw, 22px)", "leading": "1.3", "tracking": "-0.01em", "weight": 400 },
    { "name": "body", "size": "16px", "leading": "1.45", "tracking": "-0.01em", "weight": 400 }
  ],
  "radius": "6px",
  "ease": { "out-expo": "cubic-bezier(0.16, 1, 0.3, 1)", "in-out-quart": "cubic-bezier(0.76, 0, 0.24, 1)" }
}
