{
  "id": "onyx",
  "name": "Onyx",
  "description": "Pure white on black with grey numbers and one deep blue highlight. A tight grotesk in caps, light italic mono for specs, square corners, and a two-row stripe of flat test-card colours.",
  "inspiredBy": ["lib-eylon-shapes", "lib-eylon-list", "lib-eylon-sheet"],
  "colors": { "paper": "#000000", "ink": "#ffffff", "accent": "#152cca", "mist": "#2a2a2a", "muted": "#7d7979" },
  "palette": [
    { "name": "Sheet", "value": "#f5f5f5" },
    { "name": "Cerulean", "value": "#007bc8" },
    { "name": "Magenta", "value": "#ff00ff" },
    { "name": "Ocean", "value": "#0878cc" },
    { "name": "Cobalt", "value": "#0025e5" },
    { "name": "Mustard", "value": "#efd24a" },
    { "name": "Lilac grey", "value": "#9a96a7" },
    { "name": "Azure", "value": "#0289ff" },
    { "name": "Violet", "value": "#6539b4" },
    { "name": "Grass", "value": "#42ba25" },
    { "name": "Signal red", "value": "#e92622" }
  ],
  "fonts": {
    "sans": { "family": "Instrument Sans", "fallback": "'ABC Diatype', 'Helvetica Neue', Arial, sans-serif", "google": "Instrument+Sans:wght@400..700" },
    "mono": { "family": "Red Hat Mono", "fallback": "'ABC Diatype Mono', 'SF Mono', ui-monospace, monospace", "google": "Red+Hat+Mono:ital,wght@0,300..500;1,300..500" }
  },
  "type": [
    { "name": "display", "size": "clamp(48px, 6vw, 104px)", "leading": "1", "tracking": "-0.02em", "weight": 500 },
    { "name": "headline", "size": "clamp(24px, 2.5vw, 36px)", "leading": "1.1", "tracking": "-0.005em", "weight": 500 },
    { "name": "title", "size": "clamp(17px, 1.4vw, 21px)", "leading": "1.2", "tracking": "0", "weight": 500 },
    { "name": "lead", "size": "18px", "leading": "1.4", "tracking": "0", "weight": 400 },
    { "name": "body", "size": "15px", "leading": "1.45", "tracking": "0", "weight": 400 }
  ],
  "radius": "0px",
  "ease": { "out-expo": "cubic-bezier(0.16, 1, 0.3, 1)", "in-out-quart": "cubic-bezier(0.65, 0, 0.35, 1)" }
}
