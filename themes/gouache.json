{
  "id": "gouache",
  "name": "Gouache",
  "description": "Flat, opaque poster colours on black and white: a red accent, grey mist and violet, pink, green, cyan and blue blocks, all with black type on top. One grotesk at one weight, from 16px labels to 144px titles.",
  "inspiredBy": ["lib-horst", "lib-horst-wordmark", "lib-horst-trail", "lib-horst-menu"],
  "colors": { "paper": "#ffffff", "ink": "#000000", "accent": "#ea3323", "mist": "#a3a3a1", "muted": "#585858" },
  "palette": [
    { "name": "Violet", "value": "#6a2ed4" },
    { "name": "Pink", "value": "#ed82d1" },
    { "name": "Green", "value": "#049d0a" },
    { "name": "Cyan", "value": "#00dbe3" },
    { "name": "Blue", "value": "#1457ed" },
    { "name": "Olive", "value": "#787d03" },
    { "name": "Mint", "value": "#b5fdc0" },
    { "name": "Yellow", "value": "#faff00" }
  ],
  "fonts": {
    "sans": { "family": "Hanken Grotesk", "fallback": "'ABC Oracle', 'Helvetica Neue', Arial, sans-serif", "google": "Hanken+Grotesk:wght@400;500" }
  },
  "type": [
    { "name": "display", "size": "clamp(64px, 10vw, 144px)", "leading": "0.95", "tracking": "-0.045em", "weight": 400 },
    { "name": "headline", "size": "clamp(44px, 6.1vw, 88px)", "leading": "0.98", "tracking": "-0.035em", "weight": 400 },
    { "name": "title", "size": "clamp(30px, 3.9vw, 56px)", "leading": "1", "tracking": "-0.04em", "weight": 400 },
    { "name": "lead", "size": "clamp(22px, 2.8vw, 40px)", "leading": "1.05", "tracking": "-0.03em", "weight": 400 },
    { "name": "body", "size": "16px", "leading": "1.35", "tracking": "0em", "weight": 400 }
  ],
  "radius": "16px",
  "ease": { "out-expo": "cubic-bezier(0.16, 1, 0.3, 1)", "in-out-quart": "cubic-bezier(0.76, 0, 0.24, 1)" }
}
